# Microsoft Entra ID (Azure AD) settings for this single-page app.
#
# Copy this file to `.env.local` and fill in the values of your app registration.
# `.env.local` is git-ignored and is never committed.
#
# Only variables prefixed with VITE_ reach the browser bundle, so they are public:
# a SPA app registration must never have (or contain) a client secret.

# Application (client) ID of the React frontend app registration.
VITE_AZURE_CLIENT_ID=
# Tenant subdomain of the Entra External ID (CIAM) directory, e.g. "contoso" for
# contoso.ciamlogin.com. Builds https://<value>.ciamlogin.com/<value>.onmicrosoft.com
# when VITE_AZURE_AUTHORITY is left unset.
VITE_AZURE_TENANT_SUBDOMAIN=yourtenant
# Must exactly match a redirect URI registered under the "Single-page application"
# platform of the app registration. Defaults to the current origin, e.g. http://localhost:5173/
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# Optional: full authority URL. Defaults to
# https://<VITE_AZURE_TENANT_SUBDOMAIN>.ciamlogin.com/<VITE_AZURE_TENANT_SUBDOMAIN>.onmicrosoft.com
# The tenant must be part of the path — a bare host fails with endpoints_resolution_error.
# VITE_AZURE_AUTHORITY=

# Optional: comma separated list of trusted authority hosts.
# Defaults to the host of the authority above. For a name-based CIAM authority the
# discovery document's issuer is GUID-based, so list BOTH hosts or sign-in fails
# with endpoints_resolution_error (issuer_validation_failed), e.g.
# VITE_AZURE_KNOWN_AUTHORITIES=contoso.ciamlogin.com,<tenant-id>.ciamlogin.com
# VITE_AZURE_KNOWN_AUTHORITIES=

# Optional: where the browser lands after sign-out. Defaults to the redirect URI.
# VITE_AZURE_POST_LOGOUT_REDIRECT_URI=

# Optional: scope of the profile backend API, e.g. api://<backend-client-id>/.default
# or an exposed delegated scope such as api://<backend-client-id>/access_as_user.
# When set, the Profile page calls GET <VITE_API_BASE_URL>/api/Profile with an access token.
# VITE_AZURE_API_SCOPE=

# Optional: base URL of the ASP.NET Core backend. Defaults to http://localhost:5290
# (the `http` launch profile in the backend's Properties/launchSettings.json).
# VITE_API_BASE_URL=
