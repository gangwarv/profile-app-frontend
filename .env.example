# Microsoft Entra ID (Azure AD B2C) settings for this single-page app.
#
# Copy this file to `.env.local` and fill in the values of your app registration.
# `.env.local` is git-ignored and is never committed.
#
# Only variables prefixed with VITE_ reach the browser bundle, so they are public:
# a SPA app registration must never have (or contain) a client secret.

# Application (client) ID of the React frontend app registration.
VITE_AZURE_CLIENT_ID=

# B2C tenant name, i.e. the <name> in https://<name>.b2clogin.com.
VITE_AZURE_TENANT_NAME=

# B2C user flow (or custom policy) used for sign-up and sign-in, e.g. B2C_1_susi.
VITE_AZURE_SIGN_UP_SIGN_IN_POLICY=B2C_1_susi

# Optional: full authority URL. Defaults to
# https://<VITE_AZURE_TENANT_NAME>.b2clogin.com/<VITE_AZURE_TENANT_NAME>.onmicrosoft.com/<VITE_AZURE_SIGN_UP_SIGN_IN_POLICY>
# Set this when the tenant is addressed by tenant ID or a custom domain instead.
# VITE_AZURE_AUTHORITY=

# Optional: comma separated list of trusted authority hosts (required by B2C).
# Defaults to the host of the authority above.
# VITE_AZURE_KNOWN_AUTHORITIES=

# Optional: must exactly match a redirect URI registered on the app registration.
# Defaults to the current origin, e.g. http://localhost:5173/
# VITE_AZURE_REDIRECT_URI=

# Optional: where the browser lands after sign-out. Defaults to the redirect URI.
# VITE_AZURE_POST_LOGOUT_REDIRECT_URI=

# Optional: scope of your own API, e.g. https://<tenant>.onmicrosoft.com/api/access_as_user
# VITE_AZURE_API_SCOPE=
